<Window x:Class="DNDHelper.Views.MainWindow"
        x:Name="MainWindows"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DNDHelper.Views"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="D&amp;DHelper" Height="593" Width="1110" CanResize="False" IsVisible="True">
    <!--
        TODO (миграция):
        - Style="{StaticResource MaterialDesignWindow}" убран — в Material.Avalonia нет 1:1 аналога стиля окна,
          общий вид темы задаётся через App.axaml (FluentTheme/Material.Avalonia + ColorPaletteResources).
        - ResizeMode="NoResize" -> CanResize="False" (в Avalonia это bool, не enum).
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="StandartBackColor"/>
        <SolidColorBrush x:Key="StandartForeColor" Color="Black"/>
        <!-- TODO: IsEdit был Visibility (Hidden/Visible) в WPF; в Avalonia IsVisible - bool -->
        <x:Boolean x:Key="IsEdit">False</x:Boolean>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
        </Style>
        <!-- Только для рамок-разделителей из разметки (Classes="frame"). Раньше селектор "Border"
             цеплял ВСЕ Border, включая внутренности шаблонов Material-контролов -> белые рамки
             вокруг чекбоксов, текстбоксов и комбобоксов. В WPF неявный стиль в шаблоны не проникал. -->
        <Style Selector="Border.frame">
            <Setter Property="BorderBrush" Value="{DynamicResource StandartForeColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- TODO: BasedOn="{StaticResource MaterialDesignTextBox}" убран -
             в Material.Avalonia стиль текстбокса подключается темой глобально, локально переопределяем только MaxLength -->
        <Style Selector="TextBox">
            <Setter Property="MaxLength" Value="7"/>
        </Style>
        <!-- Компактные поля (Имя/Раса/Класс в режиме редактирования). Material-ComboBox по умолчанию
             ~50 px высотой, три таких поля не помещаются в строку высотой 130 и "Класс" уезжал под таблицу навыков. -->
        <!-- Два отдельных стиля: VerticalContentAlignment нет у общего предка TextBox и ComboBox
             (TemplatedControl), поэтому в одном составном селекторе XAML не компилируется (AVLN2000). -->
        <Style Selector="TextBox.compact">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox.compact">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Замена MaterialDesignFloatingActionLightButton / MaterialDesignIconForegroundButton:
             минималистичная безрамочная кнопка-иконка. Подгони под свою тему. -->
        <Style Selector="Button.iconButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.iconButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Styles>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" Grid.ColumnSpan="2" FontSize="15">
            <MenuItem Header="Персонаж">
                <MenuItem x:Name="AddCharacter" Header="Новый..."/>
                <MenuItem Header="Загрузить..."/>
                <MenuItem Header="Сохранить как..."/>
                <Separator />
                <MenuItem x:Name="CharactersMenu" Header="Персонажи">
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Программа">
                <MenuItem Header="Режим редактирования" ToggleType="CheckBox" x:Name="EditMode_button" Click="EditMode_click"/>
                <MenuItem Header="Настройки" Click="Settings_Click" x:Name="Settings_Button"/>
                <MenuItem Header="Обновить конфиг" Click="UpdateConfingsInHands_Click"/>
                <MenuItem Header="Проверить обновления" Click="CheckUpdate_Click"/>
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
            <MenuItem Header="Ссылки">
                <MenuItem Header="Правила Гюнтера" Click="UrlGunter"/>
                <MenuItem Header="Правила Туши" Click="UrlTusha"/>
                <MenuItem Header="Оружие и броня Туши" Click="UrlWeapons"/>
                <MenuItem Header="Расы Туши" Click="UrlRaces"/>
                <MenuItem Header="Классы Туши" Click="UrlClasses"/>
            </MenuItem>
            <MenuItem x:Name="Magic_menuitem" Header="Магия" IsVisible="False">
                <MenuItem Header="Проклятая магия" x:Name="Cursemagic_menuitem" Click="Cursemagic_menuitem_Click"/>
            </MenuItem>
        </Menu>
        <StackPanel x:Name="WorkProgam1" ZIndex="10" IsVisible="True" VerticalAlignment="Center" Margin="10,50,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Имя:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0" Width="60" />
                <TextBlock Text="{Binding Name}" x:Name="character_name_textblock" Width="120" IsVisible="True" VerticalAlignment="Center" />
                <TextBox TextChanged ="character_name_textbox_TextChanged"  Text="{Binding Name}" Classes="compact" Width="120" x:Name="character_name_textbox" Watermark="Имя" IsVisible="False" MaxLength="254"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Раса:" HorizontalAlignment="Left" VerticalAlignment="Center"  Margin="0,0,0,0" Width="60" />
                <TextBlock Text="[[Раса]]" x:Name="character_race_textblock" Width="120" IsVisible="True" VerticalAlignment="Center" />
                <ComboBox SelectedIndex="{Binding SelectedRace}" Classes="compact" Width="120" x:Name="character_race_combobox" PlaceholderText="Раса" IsVisible="False"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Класс:" HorizontalAlignment="Left" VerticalAlignment="Center"  Margin="0,0,0,0" Width="60"/>
                <TextBlock Text="[[Класс]]" x:Name="character_class_textblock" Width="120" IsVisible="True" VerticalAlignment="Center" />
                <ComboBox SelectedIndex="{Binding SelectedClass}" Classes="compact" Width="120" x:Name="character_class_combobox" PlaceholderText="Класс" IsVisible="False"/>
            </StackPanel>
        </StackPanel>
        <StackPanel x:Name="WorkProgam2" IsVisible="True">
            <materialIcons:MaterialIcon x:Name="ImageIconCharacter" Kind="FileImageAdd" Height="60" Width="60" Margin="200,50,0,0" IsVisible="True"/>
            <Image x:Name="ImageCharacter" Height="60" Width="60" Margin="200,50,0,0" IsVisible="False"/>
        </StackPanel>
        <StackPanel x:Name="WorkProgam3" IsVisible="True" Grid.Column="1" HorizontalAlignment="Left" Margin="0,50,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Width="135" Text="Действия:" TextAlignment="Right"/>
                <TextBlock x:Name="Actions_textblock" Width="26" Text="0" TextAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Width="135" Text="Контрдействия:" TextAlignment="Right"/>
                <TextBlock x:Name="Counter_actions_textblock" Width="26" Text="0" TextAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Width="135" Text="Палки хода:" TextAlignment="Right"/>
                <TextBlock x:Name="Movesticks_textblock" Width="26" Text="0" TextAlignment="Center"/>
            </StackPanel>
        </StackPanel>
        <StackPanel x:Name="WorkProgam4" IsVisible="True" Grid.Column="1" HorizontalAlignment="Left" Margin="180,50,0,0">
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                <TextBlock x:Name="СriticalRoll_Text_textblock" Width="135" Text="Ролл крит:" TextAlignment="Right" IsVisible="False"/>
                <TextBlock x:Name="СriticalRoll_GreaterOrEqual_textblock"  Width="10" Text=">" TextDecorations="Underline" TextAlignment="Right" IsVisible="False"/>
                <TextBlock x:Name="СriticalRoll_Number_textblock" Width="20" Text="0" TextAlignment="Center" IsVisible="False"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ResetHealth" Margin="0,-2,0,0" Height="10" Width="10" Classes="iconButton" Cursor="Hand">
                    <materialIcons:MaterialIcon Kind="Reload" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                <TextBlock Width="69" Text="Здоровье:" TextAlignment="Right" HorizontalAlignment="Center"  VerticalAlignment="Center"/>
                <TextBox Foreground="{DynamicResource StandartForeColor}" Background="{DynamicResource StandartBackColor}" x:Name="CurrentHealth_textbox" Width="40" Height="17" Text="20" TextAlignment="Center" IsVisible="False" Watermark="Число" AcceptsReturn="False"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="CurrentHealth_textblock" Width="30" Text="0" TextAlignment="Right"  VerticalAlignment="Center" />
                    <TextBlock x:Name="CurrentShieldHealth_textblock" Width="25" TextAlignment="Left"  VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Width="5" Text="|" TextAlignment="Center"  VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="MaxHealth_textblock"  Width="30" Text="0" TextAlignment="Right"  VerticalAlignment="Center"/>
                    <TextBlock x:Name="MaxShieldHealth_textblock" Width="25" TextAlignment="Left"  VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="DamageHealth_textblock"  Width="30" Text="0" TextAlignment="Center"  VerticalAlignment="Center" Foreground="Red"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Width="135" Text="Ментальное КД:" TextAlignment="Right"/>
                <TextBlock x:Name="MentalKD_TextBlock" Width="40" Text="0" TextAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Width="93" Text="КД головы:" TextAlignment="Right"/>
                <TextBlock x:Name="HeadKD_TextBlock" Width="40" Text="0" TextAlignment="Center"/>
                <TextBlock Width="30" Text="КД:" TextAlignment="Right"/>
                <TextBlock x:Name="KD_TextBlock" Width="40" Text="0" TextAlignment="Center"/>
            </StackPanel>
        </StackPanel>
        <StackPanel x:Name="WorkProgam5" IsVisible="True" Grid.Column="1" Margin="400,10,0,0">
            <StackPanel Orientation="Horizontal" Margin="36,0,0,0">
                <ComboBox x:Name="TypeMagicShield" Classes="compact" Height="22" SelectedIndex="{Binding SelectedTypeMagicShield}" PlaceholderText="Тип щита" Width="100">
                    <ComboBoxItem Content="Элементальный"/>
                    <ComboBoxItem Content="Физический"/>
                    <ComboBoxItem Content="От всего"/>
                </ComboBox>
                <TextBox Classes="compact" Height="22" Watermark="ХП" Text="{Binding MaxMagicShield, UpdateSourceTrigger=PropertyChanged}" Width="55" TextAlignment="Center" x:Name="shield_health_textbox"/>
                <CheckBox Content="КД головы" Margin="0,0,0,0" MinHeight="0" Height="22" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <materialIcons:MaterialIcon x:Name="CountDamage_button" Width="20" Height="20" Kind="SwordCross" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,-10,10,0" />
                <Border Classes="frame">
                    <DataGrid Width="169" x:Name="DamageGrid"
ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					  AutoGenerateColumns="False"
					  CanUserReorderColumns="False"
					  CanUserResizeColumns="False"
					  CanUserSortColumns="False" Height="89">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="AddTypeDamage" Header="Добавить"/>
                                <MenuItem x:Name="DeleteTypeDamage" Header="Удалить"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="90" Header=" Тип урона">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding NameType, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="Рубящий"/>
                                            <ComboBoxItem Content="Колющий"/>
                                            <ComboBoxItem Content="Дробящий"/>
                                            <ComboBoxItem Content="Холодный"/>
                                            <ComboBoxItem Content="Огненный"/>
                                            <ComboBoxItem Content="Электрический"/>
                                            <ComboBoxItem Content="Божественный"/>
                                            <ComboBoxItem Content="Эфирный"/>
                                            <ComboBoxItem Content="Некротический"/>
                                            <ComboBoxItem Content="Звуковой"/>
                                            <ComboBoxItem Content="Ментальный"/>
                                            <ComboBoxItem Content="Без Дебаффов"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Урон" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="-12,0,0,0">
                                                <CheckBox ToolTip.Tip="{Binding TextCheckBox}" IsChecked="{Binding CheckBox, UpdateSourceTrigger=PropertyChanged}" IsVisible="{Binding VisibilityCheckBox}"/>
                                                <TextBox Classes="damageTextBox" FontSize="11" MaxLength="5" Text="{Binding Damage, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        
                        
                    
<DataGrid.Styles>
<Style Selector="DataGridRow">
                                <Setter Property="Height" Value="37"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource StandartForeColor}"/>
                                <Setter Property="Background" Value="{DynamicResource StandartBackColor}"/>
                            </Style>
<Style Selector="DataGridColumnHeader">
                                <Setter Property="Foreground" Value="{DynamicResource StandartForeColor}"/>
                                <Setter Property="Background" Value="{DynamicResource StandartBackColor}"/>
                            </Style>
</DataGrid.Styles>
</DataGrid>
                </Border>
            </StackPanel>
        </StackPanel>
        <StackPanel x:Name="WorkProgam6" IsVisible="True" Grid.Column="1" Margin="636,35,0,0">
            <!-- HorizontalAlignment="Left": иначе Border растягивается на всю ширину ячейки (до края окна) и обрезается -->
            <Border Classes="frame" HorizontalAlignment="Left">
                <DataGrid Width="185" HorizontalAlignment="Left" x:Name="DataGridStatusEffects" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					  AutoGenerateColumns="False"
					  CanUserReorderColumns="False"
					  CanUserResizeColumns="False"
					  CanUserSortColumns="False" Height="87">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="AddEffect" Header="Добавить"/>
                            <MenuItem x:Name="DeleteEffect" Header="Удалить"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="100" Header=" Эффект">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox SelectionChanged="ComboBoxDataGridItemBaffsList_SelectionChanged" SelectedItem="{Binding SelectedEffect, UpdateSourceTrigger=PropertyChanged}">
                                        <sys:String>Кровотечение</sys:String>
                                        <sys:String>Оглушение</sys:String>
                                        <sys:String>Горение</sys:String>
                                        <sys:String>Обморожение</sys:String>
                                        <sys:String>Шок</sys:String>
                                        <sys:String>Безумие</sys:String>
                                        <sys:String>Усталость</sys:String>
                                        <sys:String>Яд</sys:String>
                                        <sys:String>Болевой шок</sys:String>
                                        <sys:String>Голод</sys:String>
                                        <sys:String>Ярость</sys:String>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Уровень" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding LevelString}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-10,0,0,0"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0">
                                            <Button Classes="iconButton" Width="12" Height="12" Margin="2" Click="AddLevelEffect_Click">
                                                <TextBlock Text="+" Margin="0,-4,0,0" FontSize="16" />
                                            </Button>
                                            <Button Classes="iconButton" Width="12" Height="12" Margin="2" Click='SubtractLevelEffect_Click'>
                                                <TextBlock Text="-" Margin="0,-8,0,0" FontSize="22" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    
                    
                
<DataGrid.Styles>
<Style Selector="DataGridRow">
                            <Setter Property="Height" Value="37"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Foreground" Value="{DynamicResource StandartForeColor}"/>
                            <Setter Property="Background" Value="{DynamicResource StandartBackColor}"/>
                            <Setter Property="ToolTip.Tip" Value="{Binding ToolTip}"/>
                        </Style>
<Style Selector="DataGridColumnHeader">
                            <Setter Property="Foreground" Value="{DynamicResource StandartForeColor}"/>
                            <Setter Property="Background" Value="{DynamicResource StandartBackColor}"/>
                        </Style>
</DataGrid.Styles>
</DataGrid>
            </Border>
        </StackPanel>
        <TextBlock x:Name="сharacter_weight_textblock" IsVisible="True" Text="Вес: 0/0" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
        <TextBlock Text="13.0  " x:Name="VersionTextBlock" Height="18" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right" Margin="0,13,0,89" RenderTransformOrigin="0.457,3.169"/>

        <TabControl x:Name="WorkProgam7" IsVisible="True" Grid.Row="1" Grid.Column="1" Margin="0,0,0,-304">
            <TabItem Header="Инвентарь">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120*"/>
                        <RowDefinition Height="70*"/>
                    </Grid.RowDefinitions>
                    <Border Classes="frame" Grid.ColumnSpan="4">
                        <DataGrid x:Name="DataGridInventory" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
							 Grid.ColumnSpan="4"
							 AutoGenerateColumns="False"
							 CanUserReorderColumns="False"
							 CanUserResizeColumns="False"
							 CanUserSortColumns="False">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="AddMenuItem" Header="Добавить"/>
                                    <MenuItem x:Name="DeleteMenuItem" Header="Удалить"/>
                                    <MenuItem x:Name="CopyMenuItem" Header="Копировать"/>
                                    <MenuItem x:Name="PasteMenuItem" Header="Вставить"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Название" Width="140" SortMemberPath="Name">
<DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{Binding ForeColorKDEquipped}" VerticalAlignment="Center" Margin="5,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
<DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding Name}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Вес" Width="65" SortMemberPath="Weight">
<DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Weight}" FontSize="{Binding FontStyleWeight}" Foreground="{Binding ForeColorWeight}" VerticalAlignment="Center" Margin="5,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
<DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding Weight}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>

                                <!-- TODO: Avalonia.Controls.DataGrid не имеет DataGridComboBoxColumn -
                                     переписано на DataGridTemplateColumn с ComboBox внутри. -->
                                <DataGridTemplateColumn Header="Качество" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding Quality, Mode=TwoWay}">
                                                
                                                        <sys:String>Нет</sys:String>
                                                        <sys:String>Прото</sys:String>
                                                        <sys:String>Плохое</sys:String>
                                                        <sys:String>Стандартное</sys:String>
                                                        <sys:String>Высокое</sys:String>
                                                        <sys:String>Великолепное</sys:String>
                                                        <sys:String>Мастерское</sys:String>
                                                        <sys:String>Мифическое</sys:String>
                                                    
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Рубящий" Binding="{Binding WholeChopping}" Width="88">
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Колющий" Binding="{Binding WholeStabbing}" Width="93">
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Дробящий" Binding="{Binding WholeCrushing}" Width="99">
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Тяжесть" Binding="{Binding Severity}" Width="81">
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="КД" Width="60" SortMemberPath="WholeKD">
<DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding WholeKD}" Foreground="{Binding ForeColorKD}" VerticalAlignment="Center" Margin="5,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
<DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding WholeKD}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>
                                <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="70">
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="CountWeight" Binding="{Binding CountWeight}" IsVisible="False"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" IsVisible="False"/>
                                <DataGridTextColumn Header="CountKD" Binding="{Binding CountKD}" IsVisible="False"/>
                                <DataGridTextColumn Header="CountKDHelmet" Binding="{Binding CountKDHelmet}" IsVisible="False"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Classes="frame" Grid.Row="1">
                        <TextBox x:Name="DescriptionTextBox" Watermark="Описание" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" MaxLength="10000"/>
                    </Border>
                    <Border Classes="frame" Grid.Row="1" Grid.Column="1">
                        <DataGrid x:Name="DataGridItemBaffsList" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
							  AutoGenerateColumns="False"
                              SelectionMode="Single"
							  CanUserReorderColumns="False"
							  CanUserResizeColumns="False"
							  CanUserSortColumns="False">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="AddMenuItemBaff" Header="Добавить"/>
                                    <MenuItem x:Name="DeleteMenuItemBaff" Header="Удалить"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="85" Header=" Параметр">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectionChanged="ComboBoxDataGridItemBaffsList_SelectionChanged" SelectedIndex="{Binding SelectedIndex, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem Content="Сила"/>
                                                <ComboBoxItem Content="Атлетика"/>
                                                <ComboBoxItem Content="Ловкость"/>
                                                <ComboBoxItem Content="Акробатика"/>
                                                <ComboBoxItem Content="Ловкость рук"/>
                                                <ComboBoxItem Content="Скрытность"/>
                                                <ComboBoxItem Content="Телосложение"/>
                                                <ComboBoxItem Content="Интеллект"/>
                                                <ComboBoxItem Content="Магия"/>
                                                <ComboBoxItem Content="Религия"/>
                                                <ComboBoxItem Content="Природа"/>
                                                <ComboBoxItem Content="История"/>
                                                <ComboBoxItem Content="Расследование"/>
                                                <ComboBoxItem Content="Технология"/>
                                                <ComboBoxItem Content="Мудрость"/>
                                                <ComboBoxItem Content="Медицина"/>
                                                <ComboBoxItem Content="Восприятие"/>
                                                <ComboBoxItem Content="Проницательность"/>
                                                <ComboBoxItem Content="Выживание"/>
                                                <ComboBoxItem Content="Уход за животными"/>
                                                <ComboBoxItem Content="Харизма"/>
                                                <ComboBoxItem Content="Обман"/>
                                                <ComboBoxItem Content="Запугивание"/>
                                                <ComboBoxItem Content="Выступление"/>
                                                <ComboBoxItem Content="Убеждение"/>
                                                <ComboBoxItem Content="Очарование"/>
                                                <ComboBoxItem Content="Иммунитет"/>
                                                <ComboBoxItem Content="Баланс"/>
                                                <ComboBoxItem Content="Стойкость"/>
                                                <ComboBoxItem Content="Закалка"/>
                                                <ComboBoxItem Content="Ролл атаки"/>
                                                <ComboBoxItem Content="Ролл блока"/>
                                                <ComboBoxItem Content="Ролл уворота"/>
                                                <ComboBoxItem Content="Ролл контрдействия"/>
                                                <ComboBoxItem Content="Ролл атаки кулаками"/>
                                                <ComboBoxItem Content="Ролл дальнобойным"/>
                                                <ComboBoxItem Content="Вес"/>
                                                <ComboBoxItem Content="Здоровье"/>
                                                <ComboBoxItem Content="Ментальное КД"/>
                                                <ComboBoxItem Content="Палка Хода"/>
                                                <ComboBoxItem Content="Действие"/>
                                                <ComboBoxItem Content="Контрдействие"/>
                                                <ComboBoxItem Content="Маг. пули"/>
                                                <ComboBoxItem Content="Маг. ролл"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="60" Header="Значение" Binding="{Binding WholeAddValue, UpdateSourceTrigger=PropertyChanged}" >
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="50" Header=" Ролл" Binding="{Binding WholeAddRoll, UpdateSourceTrigger=PropertyChanged}">
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                            
                        
<DataGrid.Styles>
<Style Selector="DataGridColumnHeader">
                                    <Setter Property="Foreground" Value="{DynamicResource StandartForeColor}"/>
                                    <Setter Property="Background" Value="{DynamicResource StandartBackColor}"/>
                                    <Setter Property="FontSize" Value="14"/>
                                </Style>
</DataGrid.Styles>
</DataGrid>
                    </Border>
                    <Border Classes="frame" Grid.Row="1" Grid.Column="2">
                        <!-- Material-контролы выше WPF-шных: без Viewbox содержимое выходит за рамку ячейки -->
                        <Viewbox StretchDirection="DownOnly" Stretch="Uniform">
                        <StackPanel Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="weight_count_checkbox" Content="Считать вес"/>
                                    <CheckBox x:Name="equipped_checkbox" Margin="5,0,0,0" Content="Надето"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="kd_count_checkbox" Content="КД"/>
                                    <CheckBox x:Name="kdhelmet_count_checkbox" Margin="10,0,0,0" Content="КД шлема"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock Text="Медяк" Margin="0,5,0,0" Width="110" Foreground="Orange"/>
                                <TextBox Text="{Binding Copper, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Watermark="Число" Width="40" x:Name="Cuprum_tb"/>
                            </StackPanel>
                            <StackPanel Margin="0,5,0,5" Orientation="Horizontal">
                                <TextBlock Text="Серебреник" Width="110" Foreground="Gray"/>
                                <TextBox Text="{Binding Silver, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Watermark="Число" Width="40" x:Name="Silver_tb"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Золотой" Width="110" Foreground="Gold"/>
                                <TextBox Text="{Binding Gold, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Watermark="Число" Width="40" x:Name="Gold_tb" TextChanged="Gold_tb_TextChanged"/>
                            </StackPanel>
                        </StackPanel>
                        </Viewbox>
                    </Border>
                    <Border Classes="frame" Grid.Row="1" Grid.Column="3">
                        <!-- Material-контролы выше WPF-шных: без Viewbox содержимое выходит за рамку ячейки -->
                        <Viewbox StretchDirection="DownOnly" Stretch="Uniform">
                        <StackPanel Margin="5,0,0,0" VerticalAlignment="Center">
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock FontSize="12" Text="Рюкзак" Width="75" VerticalAlignment="Center"/>
                                <ComboBox PlaceholderText="Нет" Width="110" x:Name="backpack_cb" SelectedIndex="{Binding SelectedBackpack}" SelectionChanged="backpack_cb_SelectionChanged">
                                    <ComboBoxItem Content="Нет"/>
                                    <ComboBoxItem Content="Прото"/>
                                    <ComboBoxItem Content="Плохой"/>
                                    <ComboBoxItem Content="Стандартный"/>
                                    <ComboBoxItem Content="Высокий"/>
                                    <ComboBoxItem Content="Великолепный"/>
                                    <ComboBoxItem Content="Мастерский"/>
                                    <ComboBoxItem Content="Мифический"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,0" Orientation="Horizontal">
                                <TextBlock FontSize="12" Text="Кол-во" Width="75" VerticalAlignment="Center"/>
                                <ComboBox SelectedIndex="{Binding BackpackQuantity}" PlaceholderText="Нет" Width="40" x:Name="backpack_quantity_cb" ItemsSource="{x:Null}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="25"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12" Text="Добавить к весу" TextWrapping="Wrap" Width="75"/>
                                <TextBox Text="{Binding AddWeight}" Watermark="Число" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Width="40" x:Name="backpack_plus_tb" MaxLength="7"/>
                            </StackPanel>
                            <Separator/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12" Text="Тип брони" TextWrapping="Wrap" VerticalAlignment="Center" Width="75"/>
                                <ComboBox SelectedIndex="{Binding SelectedQualityArmor}" PlaceholderText="Число"  Width="72" x:Name="armor_type_cb">
                                    <ComboBoxItem Content="Нет"/>
                                    <ComboBoxItem Content="Лёгкая"/>
                                    <ComboBoxItem Content="Средняя"/>
                                    <ComboBoxItem Content="Тяжёлая"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                        </Viewbox>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Способности">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="DataGridChartherCharacterAbilities" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
							  AutoGenerateColumns="False"
                              SelectionMode="Single"
							  CanUserReorderColumns="False"
							  CanUserResizeColumns="False"
							  CanUserSortColumns="False"
							  Grid.RowSpan="2">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="AddMenuSkill" Header="Добавить"/>
                                <MenuItem x:Name="DeleteMenuSkill" Header="Удалить"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Способность" Width="150" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Происхождение" Width="150" Binding="{Binding Origin}"/>
                            <DataGridTextColumn Header="Описание" IsVisible="False" Binding="{Binding Description}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Classes="frame" Grid.Column="1" Grid.ColumnSpan="2"/>
                    <Border Classes="frame" Grid.RowSpan="2"/>
                    <Border Classes="frame" Grid.Column="2" Grid.Row="1"/>
                    <Border Classes="frame" Grid.Column="1" Grid.Row="1"/>
                    <TextBox MaxLength="0" x:Name="Ability_TextBox" AcceptsReturn="True" Watermark="Описание" Grid.Column="1" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="5,0,5,0" Height="190" IsReadOnly="True" VerticalContentAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Уровень:" Width="150" VerticalAlignment="Center"/>
                            <TextBlock x:Name="сharacter_level_textblcok" Width="40" Text="0" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button x:Name="pluslevel" Classes="iconButton" Width="10" Height="10" IsVisible="{DynamicResource IsEdit}">
                                <TextBlock Text="+" Margin="0,-5,0,0" FontSize="18"/>
                            </Button>
                            <Button x:Name="minuslevel" Classes="iconButton" Margin="5" Width="10" Height="10" IsVisible="{DynamicResource IsEdit}" Cursor="Hand">
                                <TextBlock Text="-" Margin="0,-6.29,0,0" FontSize="18"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="character_rollattackname_textblock" Text="Ролл атаки:" Width="150" VerticalAlignment="Center"/>
                            <TextBlock x:Name="character_rollattack_textblock" Width="40" Text="0" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="character_blockname_textblock" Text="Ролл блока:" Width="150" VerticalAlignment="Center"/>
                            <TextBlock x:Name="character_block_textblock" Width="40" Text="0" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="character_dodgename_textblock" Text="Ролл уворота:" Width="150" VerticalAlignment="Center"/>
                            <TextBlock x:Name="character_dodge_textblock" Width="40" Text="0" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="character_counteractionname_textblock" Text="Ролл контрдействия:" Width="150" VerticalAlignment="Center"/>
                            <TextBlock x:Name="character_counteraction_textblock" Width="40" Text="0" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="character_fistattackname_textblock" Text="Ролл атаки кулаками:" Width="150" VerticalAlignment="Center"/>
                            <TextBlock x:Name="character_fistattack_textblock" Width="40" Text="0" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="character_longrangeattackname_textblock" Text="Ролл дальнобойным:" Width="150" VerticalAlignment="Center"/>
                            <TextBlock x:Name="character_longrangeattack_textblock" Width="40" Text="0" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="DataGridTreeDevelopment" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              IsReadOnly="True"
							  AutoGenerateColumns="False"
                              SelectionMode="Single"
							  CanUserReorderColumns="False"
							  CanUserResizeColumns="False"
							  CanUserSortColumns="False"
							  Grid.Row="1" Grid.Column="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="180" Header="Название" Binding="{Binding TreeName}"/>
                            <DataGridTemplateColumn Header="Ступень" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding TreeLevel}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="15,0,0,0">
                                                <Button Classes="iconButton" IsVisible="{DynamicResource IsEdit}"  Width="12" Height="12" Margin="2" Click="AddTreeLevel_Click">
                                                    <TextBlock Text="+" Margin="0,-4,1,0" FontSize="16" />
                                                </Button>
                                                <Button Classes="iconButton" IsVisible="{DynamicResource IsEdit}" Width="12" Height="12" Margin="2" Click="SubtractTreeLevel_Click">
                                                    <TextBlock Text="-" Margin="0,-8,1,0" FontSize="22" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Магия">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="59*"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="60*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="21*"/>
                        <RowDefinition Height="21*"/>
                        <RowDefinition Height="96*"/>
                        <RowDefinition Height="47*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,6,0" Height="36" Grid.ColumnSpan="2">
                        <StackPanel>
                            <TextBlock Text="Школа:"/>
                            <ComboBox Classes="compact" Height="22" SelectedIndex="{Binding MagicSchool}" x:Name="SchoolSelect_cb" Width="120">
                                <ComboBoxItem Content="Отсутствует"/>
                                <ComboBoxItem Content="Ограждения"/>
                                <ComboBoxItem Content="Вызова"/>
                                <ComboBoxItem Content="Прорицания"/>
                                <ComboBoxItem Content="Очарования"/>
                                <ComboBoxItem Content="Воплощения"/>
                                <ComboBoxItem Content="Иллюзии"/>
                                <ComboBoxItem Content="Некромантии"/>
                                <ComboBoxItem Content="Преобразования"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Катализатор:"/>
                            <ComboBox Classes="compact" Height="22" SelectedIndex="{Binding CatalyzerSelect}" x:Name="CatalyzerSelect_cb">
                                <ComboBoxItem Content="Посох"/>
                                <ComboBoxItem Content="Палочка"/>
                                <ComboBoxItem Content="Талисман"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Качество:"/>
                            <ComboBox Classes="compact" Height="22" SelectedIndex="{Binding CatalyzerQualitySelect}"  x:Name="CatalyzerQualitySelect_cb" Width="100">
                                <ComboBoxItem Content="Прото"/>
                                <ComboBoxItem Content="Плохое"/>
                                <ComboBoxItem Content="Стандартное"/>
                                <ComboBoxItem Content="Высокое"/>
                                <ComboBoxItem Content="Великолепное"/>
                                <ComboBoxItem Content="Мастерское"/>
                                <ComboBoxItem Content="Мифическое"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center" Height="18">
                        <TextBlock Text="Множитель урона:"/>
                        <TextBlock Width="40" TextAlignment="Center" x:Name="DamageMagic_textblock" Text="1"  IsVisible="True" PointerPressed="DamageMagic_textblock_MouseLeftButtonDown"/>
                        <TextBox Foreground="{DynamicResource StandartForeColor}" Background="{DynamicResource StandartBackColor}" x:Name="DamageMagic_textbox" Width="40" Height="17" Text="1" TextAlignment="Center" IsVisible="False" Watermark="Число" AcceptsReturn="False" VerticalAlignment="Top" KeyDown="DamageMagic_textbox_PreviewKeyDown" MaxLength="6"/>
                        <TextBlock Text="Магические пули:"/>
                        <TextBlock Width="40" TextAlignment="Center" x:Name="MagicBulletCurrent_textblock" Text="1"  IsVisible="True" PointerPressed="MagicBulletCurrent_textblock_MouseLeftButtonDown"/>
                        <TextBox Foreground="{DynamicResource StandartForeColor}" Background="{DynamicResource StandartBackColor}" x:Name="MagicBulletCurrent_textbox" Width="40" Height="17" Text="1" TextAlignment="Center" IsVisible="False" Watermark="Число" AcceptsReturn="False" VerticalAlignment="Top" KeyDown="MagicBulletCurrent_textbox_PreviewKeyDown" MaxLength="2"/>
                        <TextBlock Text="|"/>
                        <TextBlock Width="40" TextAlignment="Center" x:Name="MagicBulletAll_textblock" Text="1"  IsVisible="True"/>
                        <Button x:Name="plusMagicBullet" Classes="iconButton" Width="10" Height="10">
                            <TextBlock Text="+" Margin="0,-5,0,0" FontSize="18"/>
                        </Button>
                        <Button x:Name="MinusMagicBullet" Classes="iconButton" Width="10" Height="10" Margin="5,0,0,0">
                            <TextBlock Text="-" Margin="0,-6.29,0,0" FontSize="18"/>
                        </Button>
                        <Button x:Name="ResetMagicBullet" Margin="5,0,0,0" Height="10" Width="10" Classes="iconButton" Cursor="Hand">
                            <materialIcons:MaterialIcon Kind="Reload" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="4" Margin="5,0,5,0" VerticalAlignment="Center" Height="42">
                        <StackPanel>
                            <TextBlock Text="Поиск"/>
                            <TextBox Classes="compact" Height="22" Watermark="Название" x:Name="CastSearch_textbox" Width="180" MaxLength="255"/>
                        </StackPanel>
                        <StackPanel Margin="15,0,0,0">
                            <TextBlock Text="Вид"/>
                            <ComboBox Classes="compact" Height="22" Width="120" SelectedIndex="0" x:Name="CastSearch_Type_cb">
                                <ComboBoxItem Content="Все"/>
                                <ComboBoxItem Content="Обычные"/>
                                <ComboBoxItem Content="Запрещённые"/>
                                <ComboBoxItem Content="Тайные"/>
                                <ComboBoxItem Content="Проклятые"/>
                                <ComboBoxItem Content="Созданные"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="15,0,0,0">
                            <TextBlock Text="Школа"/>
                            <ComboBox Classes="compact" Height="22" SelectedIndex="0" x:Name="SchoolSelect_Search_cb" Width="130">
                                <ComboBoxItem Content="Любая"/>
                                <ComboBoxItem Content="Ограждения"/>
                                <ComboBoxItem Content="Вызова"/>
                                <ComboBoxItem Content="Прорицания"/>
                                <ComboBoxItem Content="Очарования"/>
                                <ComboBoxItem Content="Воплощения"/>
                                <ComboBoxItem Content="Иллюзии"/>
                                <ComboBoxItem Content="Некромантии"/>
                                <ComboBoxItem Content="Преобразования"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="15,0,0,0">
                            <TextBlock Text="Урон"/>
                            <ComboBox Classes="compact" Height="22" SelectedIndex="0" x:Name="Damage_Search_cb" Width="65">
                                <ComboBoxItem Content="Любой"/>
                                <ComboBoxItem Content="Есть"/>
                                <ComboBoxItem Content="Нет"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="15,0,0,0">
                            <TextBlock Text="Ролл"/>
                            <ComboBox Classes="compact" Height="22" SelectedIndex="0" x:Name="Roll_Search_cb" Width="60">
                                <ComboBoxItem Content="Любой"/>
                                <ComboBoxItem Content="&gt;0"/>
                                <ComboBoxItem Content="&lt;0"/>
                                <ComboBoxItem Content="0"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="15,0,0,0">
                            <TextBlock Text="Уровень"/>
                            <ComboBox Classes="compact" Height="22" SelectedIndex="0" x:Name="LevelCast_Search_cb" Width="80">
                                <ComboBoxItem Content="Все"/>
                                <ComboBoxItem Content="Заговоры"/>
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="6"/>
                                <ComboBoxItem Content="7"/>
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="9"/>
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="11"/>
                                <ComboBoxItem Content="12"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="NatureCast_Search_cb" Content="Природное" Margin="10,15,0,0"/>
                        <CheckBox x:Name="PackCast_Search_cb" Content="В колоде" Margin="-90,-20,0,0"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Grid.ColumnSpan="4"
							  x:Name="DataGridCurrentSpells" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
							  AutoGenerateColumns="False"
                              SelectionMode="Single"
							  CanUserReorderColumns="False"
							  CanUserResizeColumns="False"
							  IsReadOnly="True"
							  Grid.RowSpan="3"
							  CanUserSortColumns="True" Margin="0,42,0,0">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="AddInPackSpellCurrent" Header="В колоду" IsVisible="False"/>
                                <MenuItem x:Name="AddCustomSpellCurrent" Header="Добавить" IsVisible="False"/>
                                <MenuItem x:Name="DeleteCustomSpellCurrent" Header="Удалить" IsVisible="False"/>
                                <MenuItem x:Name="MoveSpellCurrent" Header="Переместить вправо"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        
                        

                        
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Название" Width="600" SortMemberPath="SpellName">
<DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SpellName}" Foreground="{Binding colorbrush}" VerticalAlignment="Center" Margin="5,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
<DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Classes="compact" Height="22" Text="{Binding SpellName}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Школа" Width="106" SortMemberPath="SpellSchool">
<DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SpellSchool}" Foreground="{Binding colorbrushnature}" VerticalAlignment="Center" Margin="5,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
<DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Classes="compact" Height="22" Text="{Binding SpellSchool}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>
                            <DataGridTextColumn Header="Урон" Binding="{Binding SpellDamage}" Width="36"/>
                            <DataGridTextColumn Header="Ролл" Binding="{Binding SpellRoll}" Width="35"/>
                            <DataGridTemplateColumn Header="УР" Width="30" SortMemberPath="SpellLevel">
<DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SpellLevel}" Foreground="{Binding colorbrushPack}" VerticalAlignment="Center" Margin="5,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
<DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Classes="compact" Height="22" Text="{Binding SpellLevel}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>
                            <DataGridTextColumn Header="Описание" Binding="{Binding SpellDescription}" IsVisible="False"/>
                        </DataGrid.Columns>
                    
<DataGrid.Styles>
<Style Selector="DataGridColumnHeader">
                                <Setter Property="Foreground" Value="{DynamicResource StandartForeColor}"/>
                                <Setter Property="Background" Value="{DynamicResource StandartBackColor}"/>
                            </Style>
<Style Selector="DataGridRow">
                                <Setter Property="Height" Value="20"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource StandartForeColor}"/>
                                <Setter Property="Background" Value="{DynamicResource StandartBackColor}"/>
                                <Setter Property="ToolTip.Tip" Value="{Binding SpellName}"/>
                            </Style>
<Style Selector="DataGridCell">
                                <Setter Property="Padding" Value="5,0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
</DataGrid.Styles>
</DataGrid>
                    <DataGrid Grid.Row="1" Grid.Column="2"
							  x:Name="DataGridAllSpells" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
							  AutoGenerateColumns="False"
                              SelectionMode="Single"
							  CanUserReorderColumns="False"
							  CanUserResizeColumns="False"
							  CanUserSortColumns="True" Grid.ColumnSpan="2"
							  IsReadOnly="True"
							  IsVisible="{DynamicResource IsEdit}" Margin="0,42,0,0" Grid.RowSpan="2">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="MoveSpellAll" Header="Переместить влево"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        
                        
                        
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Название" Width="200" SortMemberPath="SpellName">
<DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SpellName}" Foreground="{Binding colorbrush}" VerticalAlignment="Center" Margin="5,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
<DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Classes="compact" Height="22" Text="{Binding SpellName}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Школа" Width="106" SortMemberPath="SpellSchool">
<DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SpellSchool}" Foreground="{Binding colorbrushnature}" VerticalAlignment="Center" Margin="5,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
<DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Classes="compact" Height="22" Text="{Binding SpellSchool}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>
                            <DataGridTextColumn Header="Урон" Binding="{Binding SpellDamage}" Width="36"/>
                            <DataGridTextColumn Header="Ролл" Binding="{Binding SpellRoll}" Width="35"/>
                            <DataGridTextColumn Header="УР" Binding="{Binding SpellLevel}" Width="30"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding SpellDescription}" IsVisible="False"/>
                        </DataGrid.Columns>
                    
<DataGrid.Styles>
<Style Selector="DataGridColumnHeader">
                                <Setter Property="Foreground" Value="{DynamicResource StandartForeColor}"/>
                                <Setter Property="Background" Value="{DynamicResource StandartBackColor}"/>
                            </Style>
<Style Selector="DataGridRow">
                                <Setter Property="Height" Value="20"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource StandartForeColor}"/>
                                <Setter Property="Background" Value="{DynamicResource StandartBackColor}"/>
                                <Setter Property="ToolTip.Tip" Value="{Binding SpellName}"/>
                            </Style>
<Style Selector="DataGridCell">
                                <Setter Property="Padding" Value="5,0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
</DataGrid.Styles>
</DataGrid>
                    <TextBox x:Name="CurrentSpellDescription" Grid.Row="2" Text="[[Описание]]" IsVisible="False" Grid.RowSpan="2" TextWrapping="Wrap" Margin="0,195,0,0" Grid.ColumnSpan="4" IsReadOnly="True" Foreground="{DynamicResource StandartForeColor}" Background="{DynamicResource StandartBackColor}"/>
                    <TextBox x:Name="AllSpellDescription" Grid.Row="2" Grid.Column="2" Text="[[Описание]]" TextWrapping="Wrap" Margin="0,195,0,0" IsVisible="{DynamicResource IsEdit}" IsReadOnly="True" Foreground="{DynamicResource StandartForeColor}" Background="{DynamicResource StandartBackColor}" Grid.ColumnSpan="2" Grid.RowSpan="2"/>
                    <Border Classes="frame" Grid.Column="2" Grid.Row="1" Grid.RowSpan="3" IsVisible="{DynamicResource IsEdit}" Margin="0,42,0,0"/>
                    <Border Classes="frame" Grid.ColumnSpan="4" Grid.RowSpan="4"/>
                    <Border Classes="frame" Grid.ColumnSpan="4" Margin="0,0,0,42" Grid.RowSpan="2"/>
                    <Border Classes="frame" Grid.ColumnSpan="4" Grid.Row="1"/>
                </Grid>
            </TabItem>
            <TabItem Header="Дневник">
                <Grid>

                    <!--
                        Дневник: AvaloniaEdit + собственный слой форматирования (ViewModels/Diary/RichText.cs).
                        Заметки хранятся в .rtf. Кнопки: отмена/возврат (только текст), жирный, курсив,
                        подчёркнутый, зачёркнутый, размер шрифта (выделение или набираемый текст).
                        Списки (маркеры/нумерация) и отступы из WPF-версии не восстановлены.
                    -->
                    <DockPanel Name="mainPanel" Grid.Column="1" Grid.RowSpan="3">
                                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,5" Spacing="2">
                            <Button x:Name="diaryUndoBtn" Classes="iconButton" Width="30" Height="30" ToolTip.Tip="Отменить"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Undo" Width="18" Height="18" Foreground="DarkOrange"/>
                            </Button>
                            <Button x:Name="diaryRedoBtn" Classes="iconButton" Width="30" Height="30" ToolTip.Tip="Вернуть"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Redo" Width="18" Height="18" Foreground="DarkOrange"/>
                            </Button>
                            <Button x:Name="diaryBoldBtn" Classes="iconButton" Width="30" Height="30" ToolTip.Tip="Жирный"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FormatBold" Width="18" Height="18" Foreground="DarkOrange"/>
                            </Button>
                            <Button x:Name="diaryItalicBtn" Classes="iconButton" Width="30" Height="30" ToolTip.Tip="Курсив"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FormatItalic" Width="18" Height="18" Foreground="DarkOrange"/>
                            </Button>
                            <Button x:Name="diaryUnderlineBtn" Classes="iconButton" Width="30" Height="30" ToolTip.Tip="Подчёркнутый"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FormatUnderline" Width="18" Height="18" Foreground="DarkOrange"/>
                            </Button>
                            <Button x:Name="diaryStrikeBtn" Classes="iconButton" Width="30" Height="30" ToolTip.Tip="Зачёркнутый"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FormatStrikethrough" Width="18" Height="18" Foreground="DarkOrange"/>
                            </Button>
                            <ComboBox x:Name="fontSizeComboBox" Width="60" ToolTip.Tip="Размер шрифта" Margin="8,0,0,0">
                            
                                    <sys:Double>6</sys:Double>
                                    <sys:Double>8</sys:Double>
                                    <sys:Double>9</sys:Double>
                                    <sys:Double>10</sys:Double>
                                    <sys:Double>11</sys:Double>
                                    <sys:Double>12</sys:Double>
                                    <sys:Double>14</sys:Double>
                                    <sys:Double>16</sys:Double>
                                    <sys:Double>18</sys:Double>
                                    <sys:Double>20</sys:Double>
                                    <sys:Double>22</sys:Double>
                                    <sys:Double>24</sys:Double>
                                    <sys:Double>26</sys:Double>
                                    <sys:Double>28</sys:Double>
                                
                        </ComboBox>
                        </StackPanel>
                        <ae:TextEditor x:Name="diaryTB" ShowLineNumbers="False" WordWrap="True"
                                       Margin="10,0,0,0" FontSize="24"
                                       TextChanged="DiaryTB_TextChanged" PointerMoved="DiaryTB_MouseMove"/>
                    </DockPanel>
                    <GridSplitter Grid.RowSpan="3" IsEnabled="False" Grid.Column="1" Width="3" Height="400" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeWestEast" />
                    <TextBox Grid.Row="0" Grid.Column="0" x:Name="NameNote" Watermark="Название записи" MaxLength="120"/>
                    <Button Grid.Column="0" Grid.Row="1" x:Name="CreateNote" Content="Создать запись"/>
                    <ListBox x:Name="ListBoxNotes" Grid.Row="2" Grid.Column="0" SelectionMode="Single">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="DeleteMenuNote" Header="Удалить"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="303*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="141*"/>
                        <ColumnDefinition Width="649*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </TabItem>
            <TabItem Header="Справочники">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="ListBoxUrls" Grid.Row="2" Grid.Column="0"/>
                    <!-- Страница из urls.json показывается во встроенном браузере: NativeWebView из пакета
                         Avalonia.Controls.WebView (бесплатный с Avalonia 12). Элемент создаётся из кода при первом
                         выборе страницы (LoadingReferenceBook) и кладётся в ReferenceHost - так, если системного
                         движка нет (например, на Linux не установлен WebKitGTK), приложение просто откроет ссылку
                         во внешнем браузере. До первого выбора (и в этом запасном случае) виден текст ниже. -->
                    <TextBlock x:Name="LoadinTextUrl" Text="Выберите страницу слева" Grid.Column="1" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20"/>
                    <Border x:Name="ReferenceHost" Grid.Column="1" IsVisible="False"/>
                    <!-- Kind="Loading" - имя иконки из набора MaterialDesignThemes (Pictogrammers MDI),
                         в Material.Icons.Avalonia набор икон другой (Google Material Symbols) - ближайший аналог "Autorenew" или "Sync", проверь актуальное имя в enum MaterialIconKind. -->
                    <materialIcons:MaterialIcon Grid.Row="0" Grid.Column="0" Kind="Autorenew" Width="20" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Right" IsVisible="False" x:Name="LoadingIcon"
                                                 RenderTransformOrigin="0.5,0.5">
                        <materialIcons:MaterialIcon.Styles>
                            <Style Selector="materialIcons|MaterialIcon#LoadingIcon">
                                <Style.Animations>
                                    <Animation Duration="0:0:1" IterationCount="INFINITE">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="RotateTransform.Angle" Value="0"/>
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="RotateTransform.Angle" Value="360"/>
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </materialIcons:MaterialIcon.Styles>
                    </materialIcons:MaterialIcon>
                </Grid>
            </TabItem>
        </TabControl>
        <DataGrid ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsVisible="True" Grid.Row="1" Grid.Column="0"  SelectionMode="Single" FontSize="12" x:Name="DataGridCharacterisctics" AutoGenerateColumns="False" Margin="0,0,0,-304" IsReadOnly="True"
                  HeadersVisibility="Column"
              CanUserReorderColumns="False"
              CanUserResizeColumns="False"
              CanUserSortColumns="False"
              GridLinesVisibility="None"
              BorderThickness="0">

            <DataGrid.Columns>
                <DataGridTextColumn Header=" Навык" Binding="{Binding Name}" Width="150" FontSize="12"/>
                <DataGridTemplateColumn Header="Значение" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Value}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="15,0,0,0">
                                    <Button Classes="iconButton" IsVisible="{DynamicResource IsEdit}"  Width="12" Height="12" Margin="2" Click="AddCharacteristic_Click">
                                        <TextBlock Text="+" Margin="0,-5,0,0" FontSize="16" />
                                    </Button>
                                    <Button Classes="iconButton" IsVisible="{DynamicResource IsEdit}" Width="12" Height="12" Margin="2" Click="SubtractCharacteristic_Click">
                                        <TextBlock Text="-" Margin="0,-8,0,0" FontSize="22" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Ролл" Binding="{Binding Roll}" Width="50"/>
            </DataGrid.Columns>

            
            

            
        
<DataGrid.Styles>
<Style Selector="DataGridColumnHeader">
                    <Setter Property="Foreground" Value="{DynamicResource StandartForeColor}"/>
                    <Setter Property="Background" Value="{DynamicResource StandartBackColor}"/>
                </Style>
<Style Selector="DataGridRow">
                    <Setter Property="Height" Value="15"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Foreground" Value="{DynamicResource StandartForeColor}"/>
                    <Setter Property="Background" Value="{DynamicResource StandartBackColor}"/>
                    <Setter Property="ToolTip.Tip" Value="{Binding ToolTip}"/>
                </Style>
<Style Selector="DataGridCell">
                    <Setter Property="Padding" Value="5,0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="BorderThickness" Value="0"/>

                </Style>
</DataGrid.Styles>
</DataGrid>
        <TextBlock x:Name="WorkProgam8" IsVisible="True" Text="Выберите или создайте персонажа." FontSize="30" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
</Window>
